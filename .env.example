# ==============================================================================
# MobilePrep AI - Environment Template Example
# ==============================================================================
# Copy this file to .env.uat or .env.production and provide your credentials.
# Run Flutter with:
#   flutter run --dart-define-from-file=.env.uat
#   flutter run --release --dart-define-from-file=.env.production
# ==============================================================================

ENVIRONMENT=development
APP_TITLE=MobilePrep AI

# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
gemini_key=YOUR_GEMINI_API_KEY

# Model configurations
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
ENABLE_DEBUG_LOGS=true
