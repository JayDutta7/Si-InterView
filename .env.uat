# ==============================================================================
# MobilePrep AI - UAT (User Acceptance Testing) Environment
# ==============================================================================
# Usage:
# flutter run --dart-define-from-file=.env.uat
# ==============================================================================

ENVIRONMENT=uat
APP_TITLE=MobilePrep AI (UAT)

# Gemini API Key for UAT / Staging testing
GEMINI_KEY=AIzaSy_YOUR_UAT_GEMINI_API_KEY_HERE
GEMINI_API_KEY=AIzaSy_YOUR_UAT_GEMINI_API_KEY_HERE
gemini_key=AIzaSy_YOUR_UAT_GEMINI_API_KEY_HERE

# Model configurations
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
ENABLE_DEBUG_LOGS=true
