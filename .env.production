# ==============================================================================
# MobilePrep AI - Production Environment
# ==============================================================================
# Usage:
# flutter run --release --dart-define-from-file=.env.production
# ==============================================================================

ENVIRONMENT=production
APP_TITLE=MobilePrep AI

# Gemini API Key for Production
GEMINI_KEY=AIzaSy_YOUR_PRODUCTION_GEMINI_API_KEY_HERE
GEMINI_API_KEY=AIzaSy_YOUR_PRODUCTION_GEMINI_API_KEY_HERE
gemini_key=AIzaSy_YOUR_PRODUCTION_GEMINI_API_KEY_HERE

# Model configurations
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-pro
ENABLE_DEBUG_LOGS=false
